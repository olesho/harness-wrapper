/harness-wrapper
/mock
/bin/
*.test
*.out
.DS_Store

# Local secrets (provider API keys for live harness runs, e.g. CEREBRAS_API_KEY).
.env
.env.*
clients/python/__pycache__/
harness-wrapper-port
/harness-chatd

# Generated docs site (canonical sources live in docs/md/; build with `make docs`).
/docs/html/

# Generated docs site (Node port; canonical sources live in docs/md/; build with `npm run docs`).
/docs/site/

# Root package.json exists only as a no-op npm bootstrap target (see package.json); ignore its artifacts.
/node_modules/
/package-lock.json
/bun.lock

# `make test-clients` runs `npm install` in clients/typescript; both artifacts
# are generated (the suite deliberately ships no lockfile — see the Makefile).
/clients/typescript/node_modules/
/clients/typescript/package-lock.json
# Orche project control dir — generated, machine-local (config, run state, gate artifacts).
/.orche/
# Orche skills — machine-local symlinks into the orche checkout; broken on any other clone.
/.claude/skills/
# Harness local state/cache — regenerated by `harness bootstrap`, machine-local.
/.harness/
